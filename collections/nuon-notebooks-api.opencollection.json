          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/installs/:install_id/notebooks",
            "params": [
              {
                "name": "install_id",
                "value": "",
                "type": "path",
                "description": "install ID"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "offset"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "limit"
              },
              {
                "name": "q",
                "value": "",
