        {
          "info": {
            "name": "get a log stream",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/log-streams/:log_stream_id",
            "params": [
              {
                "name": "log_stream_id",
                "value": "",
                "type": "path",
                "description": "log stream ID"
              }
            ]
          },
          "docs": "Return a log stream.\n"
        },
        {
          "info": {
            "name": "read a log stream's logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/log-streams/:log_stream_id/logs",
            "headers": [
              {
                "name": "X-Nuon-API-Offset",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "log_stream_id",
                "value": "",
                "type": "path",
                "description": "log stream ID"
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "sort direction"
              },
              {
                "name": "service_name",
                "value": "",
                "type": "query",
                "description": "filter by service_name (repeatable)"
              },
              {
                "name": "scope_name",
                "value": "",
                "type": "query",
                "description": "filter by scope_name (repeatable)"
              },
              {
                "name": "severity_text",
                "value": "",
                "type": "query",
                "description": "filter by severity_text (repeatable)"
              },
              {
                "name": "tool",
                "value": "",
                "type": "query",
                "description": "filter by log_attributes['nuon.tool']"
              },
              {
                "name": "helm_release_name",
                "value": "",
                "type": "query",
                "description": "filter by log_attributes['helm.release_name']"
              },
              {
                "name": "helm_operation",
                "value": "",
                "type": "query",
                "description": "filter by log_attributes['helm.operation']"
              },
              {
                "name": "tf_workspace_id",
                "value": "",
                "type": "query",
                "description": "filter by log_attributes['tf.workspace_id']"
              },
              {
                "name": "tf_operation",
                "value": "",
                "type": "query",
                "description": "filter by log_attributes['tf.operation']"
              },
              {
                "name": "k8s_kind",
                "value": "",
                "type": "query",
                "description": "filter by log_attributes['k8s.kind']"
              },
              {
                "name": "k8s_namespace",
                "value": "",
                "type": "query",
                "description": "filter by log_attributes['k8s.namespace']"
              },
              {
                "name": "k8s_name",
                "value": "",
                "type": "query",
                "description": "filter by log_attributes['k8s.name']"
              },
              {
                "name": "trace_id",
                "value": "",
                "type": "query",
                "description": "filter by exact trace_id (dedicated CH column)"
              },
              {
                "name": "span_id",
                "value": "",
                "type": "query",
                "description": "filter by exact span_id (dedicated CH column)"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "case-insensitive substring filter on log body"
              }
            ]
          },
          "docs": "Read OTEL formatted logs for a log stream.\n"
        },
        {
          "info": {
            "name": "long-poll tail a log stream",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/log-streams/:log_stream_id/logs/tail",
            "params": [
              {
                "name": "log_stream_id",
                "value": "",
                "type": "path",
                "description": "log stream ID"
              },
              {
                "name": "since",
                "value": "",
                "type": "query",
                "description": "composite cursor in the form `<unix_nano>:<id>`; empty starts from the oldest row"
              },
              {
                "name": "wait",
                "value": "",
                "type": "query",
                "description": "max wait for new rows (Go duration, capped server-side at 30s)"
              }
            ]
          },
          "docs": "Returns rows after the supplied composite cursor, long-polling up to ~30s for new rows on an idle stream. Behind the `log-tail-long-poll` org feature flag."
        },
        {
          "info": {
            "name": "read a log stream's trace spans",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/log-streams/:log_stream_id/spans",
            "params": [
              {
                "name": "log_stream_id",
                "value": "",
                "type": "path",
                "description": "log stream ID"
              }
            ]
          },
          "docs": "Read OTEL trace spans for a log stream.\n\nReturns the flat list of spans recorded by the runner for the job execution\n(or executions) associated with this log stream, ordered by start timestamp\nASC. The frontend assembles the tree from `parent_span_id`.\n"
        },
